rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for Appointment
    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'patientPhone', 'patientEmail', 'serviceId', 'doctorId', 'date', 'time', 'status', 'createdAt'])
        && data.keys().size() == 9
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100
        && data.patientPhone is string && data.patientPhone.size() >= 8 && data.patientPhone.size() <= 20
        && data.patientEmail is string && data.patientEmail.size() <= 100 && data.patientEmail.matches('^.+@.+\\..+$')
        && data.serviceId is string && data.serviceId.size() <= 50
        && data.doctorId is string && data.doctorId.size() <= 50
        && data.date is string && data.date.size() == 10 // YYYY-MM-DD
        && data.time is string && data.time.size() >= 4 && data.time.size() <= 10
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    // 2. Collection matches
    match /appointments/{appointmentId} {
      // Allow creation for anyone (public booking)
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming());
      
      // Basic read protection
      allow get: if isSignedIn(); 
      allow list: if false; 
      
      allow update, delete: if false; 
    }
    
    // Explicitly allow connection test
    match /test/connection {
      allow read: if true;
    }
  }
}
