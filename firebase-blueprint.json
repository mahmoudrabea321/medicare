{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Details of a booked medical appointment",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientEmail": { "type": "string", "format": "email" },
        "notes": { "type": "string" },
        "serviceId": { "type": "string" },
        "doctorId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { 
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientName", "patientPhone", "patientEmail", "serviceId", "doctorId", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Medical appointments collection"
    }
  }
}
